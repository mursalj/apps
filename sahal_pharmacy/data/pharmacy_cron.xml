<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Expiry surveillance (BRD 5.8, BRD 7). Reports and raises activities; never
             writes stock off on its own, because disposal has financial and regulatory
             consequences and must stay a human decision. -->
        <record id="ir_cron_pharmacy_expiry_alert" model="ir.cron">
            <field name="name">Pharmacy: Expiry Alerts</field>
            <field name="model_id" ref="model_pharmacy_expiry_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_expiry_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- A prescription past its validity date must stop being dispensable even if
             nobody opens it, so the state is aged forward daily. -->
        <record id="ir_cron_pharmacy_expire_prescriptions" model="ir.cron">
            <field name="name">Pharmacy: Expire Old Prescriptions</field>
            <field name="model_id" ref="model_pharmacy_prescription"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_prescriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
    <record id="ir_cron_pharma_licence_alert" model="ir.cron">
        <field name="name">Pharmacy: Supplier Licence Expiry Alerts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_pharma_licence_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_pharmacy_document_expiry" model="ir.cron">
        <field name="name">Pharmacy: Regulatory Document Expiry Alerts</field>
        <field name="model_id" ref="model_pharmacy_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_document_expiry_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Internal digest for pharmacy managers. Contacts no customer, so it ships
         enabled; every customer-facing notification on this platform ships disabled. -->
    <record id="ir_cron_pharmacy_stock_alert" model="ir.cron">
        <field name="name">Pharmacy: Stock Alerts</field>
        <field name="model_id" ref="model_pharmacy_stock_intelligence"/>
        <field name="state">code</field>
        <field name="code">model._cron_stock_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
