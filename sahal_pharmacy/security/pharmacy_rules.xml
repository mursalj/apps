<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Multi-branch isolation (BRD 8: multi-company / multi-branch support). -->

        <record id="prescription_company_rule" model="ir.rule">
            <field name="name">Prescription: multi-branch</field>
            <field name="model_id" ref="model_pharmacy_prescription"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[]"/>
        </record>

        <record id="dispense_company_rule" model="ir.rule">
            <field name="name">Dispensing: multi-branch</field>
            <field name="model_id" ref="model_pharmacy_dispense"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[]"/>
        </record>

        <record id="controlled_log_company_rule" model="ir.rule">
            <field name="name">Controlled register: multi-branch</field>
            <field name="model_id" ref="model_pharmacy_controlled_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[]"/>
        </record>

    </data>
</odoo>
