<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pharmacy_profile_form" model="ir.ui.view">
        <field name="name">pharmacy.profile.form</field>
        <field name="model">pharmacy.profile</field>
        <field name="arch" type="xml">
            <form string="Pharmacy">
                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="licence_state != 'expired'">
                        <i class="fa fa-exclamation-triangle me-1" title="Expired"/>
                        <strong>Pharmacy licence expired.</strong>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="licence_state != 'expiring'">
                        <strong>Pharmacy licence expires soon.</strong>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Sahal Pharmacy — Main Branch"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="legal_name"/>
                            <field name="branch_code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="registration_no"/>
                            <field name="tax_id_no"/>
                        </group>
                        <group string="Licence">
                            <field name="licence_no"/>
                            <field name="licence_authority"/>
                            <field name="licence_expiry"/>
                            <field name="licence_state"/>
                        </group>
                    </group>
                    <group>
                        <group string="Responsible Pharmacist">
                            <field name="pharmacist_in_charge_id"/>
                            <field name="pharmacist_licence_no"/>
                        </group>
                        <group string="Operations">
                            <field name="warehouse_id"/>
                            <field name="pos_config_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Contact">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                        </group>
                        <group string="Hours">
                            <field name="opening_hours" nolabel="1"
                                   placeholder="Mon–Sat 08:00–20:00&#10;Sun 10:00–14:00"/>
                        </group>
                    </group>
                    <field name="document_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="document_type"/>
                            <field name="reference"/>
                            <field name="expiry_date"/>
                            <field name="state" widget="badge"
                                   decoration-danger="state == 'expired'"
                                   decoration-warning="state == 'expiring'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pharmacy_profile_list" model="ir.ui.view">
        <field name="name">pharmacy.profile.list</field>
        <field name="model">pharmacy.profile</field>
        <field name="arch" type="xml">
            <list decoration-danger="licence_state == 'expired'"
                  decoration-warning="licence_state == 'expiring'">
                <field name="name"/>
                <field name="branch_code" optional="show"/>
                <field name="city" optional="show"/>
                <field name="pharmacist_in_charge_id"/>
                <field name="licence_no"/>
                <field name="licence_expiry"/>
                <field name="licence_state" widget="badge"
                       decoration-success="licence_state == 'valid'"
                       decoration-warning="licence_state == 'expiring'"
                       decoration-danger="licence_state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="action_pharmacy_profile" model="ir.actions.act_window">
        <field name="name">Pharmacies</field>
        <field name="res_model">pharmacy.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Describe this pharmacy</p>
            <p>Licence, responsible pharmacist and branch details — what an inspector
               asks for first, and what a chain needs per branch.</p>
        </field>
    </record>

    <record id="view_pharmacy_manufacturer_list" model="ir.ui.view">
        <field name="name">pharmacy.manufacturer.list</field>
        <field name="model">pharmacy.manufacturer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id" optional="show"/>
                <field name="registration_no" optional="show"/>
                <field name="gmp_certificate_no" optional="hide"/>
                <field name="gmp_expiry" optional="show"/>
                <field name="product_count" string="Products"/>
                <field name="is_approved" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_manufacturer_form" model="ir.ui.view">
        <field name="name">pharmacy.manufacturer.form</field>
        <field name="model">pharmacy.manufacturer</field>
        <field name="arch" type="xml">
            <form string="Manufacturer">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="is_approved"
                            groups="sahal_pharmacy.group_pharmacy_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-medkit">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="country_id"/>
                            <field name="website"/>
                        </group>
                        <group>
                            <field name="registration_no"/>
                            <field name="gmp_certificate_no"/>
                            <field name="gmp_expiry"/>
                            <field name="is_approved" readonly="1"/>
                            <field name="approved_by_id" readonly="1"
                                   invisible="not is_approved"/>
                            <field name="approved_on" readonly="1"
                                   invisible="not is_approved"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_manufacturer" model="ir.actions.act_window">
        <field name="name">Manufacturers</field>
        <field name="res_model">pharmacy.manufacturer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pharmacy_document_list" model="ir.ui.view">
        <field name="name">pharmacy.document.list</field>
        <field name="model">pharmacy.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="reference" optional="show"/>
                <field name="issuing_authority" optional="hide"/>
                <field name="profile_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id" optional="hide"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_document_form" model="ir.ui.view">
        <field name="name">pharmacy.document.form</field>
        <field name="model">pharmacy.document</field>
        <field name="arch" type="xml">
            <form string="Regulatory Document">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Import permit — Amoxicillin"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="reference"/>
                            <field name="issuing_authority"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group string="Attached To">
                        <group>
                            <field name="profile_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="manufacturer_id"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_document" model="ir.actions.act_window">
        <field name="name">Regulatory Documents</field>
        <field name="res_model">pharmacy.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">File a document</p>
            <p>Registrations, certificates and permits with their expiry dates — so the
               pharmacy hears about a lapse before the inspector does.</p>
        </field>
    </record>

    <record id="view_pharmacy_override_list" model="ir.ui.view">
        <field name="name">pharmacy.override.list</field>
        <field name="model">pharmacy.override</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="override_date"/>
                <field name="kind"/>
                <field name="user_id"/>
                <field name="document_name"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id" optional="hide"/>
                <field name="reason"/>
                <button name="action_open_document" type="object" icon="fa-external-link"
                        title="Open the document" invisible="not res_id"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_override_search" model="ir.ui.view">
        <field name="name">pharmacy.override.search</field>
        <field name="model">pharmacy.override</field>
        <field name="arch" type="xml">
            <search string="Overrides">
                <field name="user_id"/>
                <field name="document_name"/>
                <field name="partner_id"/>
                <group name="group_by" colspan="16">
                    <filter name="g_kind" string="Type" context="{'group_by':'kind'}"/>
                    <filter name="g_user" string="Authorised By" context="{'group_by':'user_id'}"/>
                    <filter name="g_month" string="Month" context="{'group_by':'override_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_override" model="ir.actions.act_window">
        <field name="name">Authorised Overrides</field>
        <field name="res_model">pharmacy.override</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_pharmacy_override_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No overrides recorded</p>
            <p>Every time someone with authority was let past a control, with the reason
               they gave.</p>
        </field>
    </record>

</odoo>
