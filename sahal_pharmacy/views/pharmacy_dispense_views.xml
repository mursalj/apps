<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pharmacy_dispense_form" model="ir.ui.view">
        <field name="name">pharmacy.dispense.form</field>
        <field name="model">pharmacy.dispense</field>
        <field name="arch" type="xml">
            <form string="Dispensing">
                <header>
                    <button name="action_confirm" type="object" string="Confirm &amp; Dispense"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Confirming creates a sale order and moves the stock out. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_id">
                            <span>Sale Order</span>
                        </button>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="not patient_allergies">
                        <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                        <strong>Patient allergies:</strong>
                        <field name="patient_allergies" nolabel="1" readonly="1" class="oe_inline"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not has_controlled">
                        <i class="fa fa-lock me-1" title="Restricted"/>
                        Controlled substance — pharmacist only. This hand-over will be
                        written to the controlled drugs register.
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="prescription_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="patient_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="dispense_date" readonly="state != 'draft'"/>
                            <field name="pharmacist_id" readonly="state != 'draft'"/>
                            <field name="sale_order_id" readonly="1"
                                   invisible="not sale_order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="prescription_line_id" column_invisible="1"/>
                            <field name="quantity"/>
                            <field name="uom_id" optional="show"/>
                            <!-- Leave Batch empty and FEFO picks the earliest-expiring
                                 lot; fill it to override that choice deliberately. -->
                            <field name="lot_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="expiration_date" optional="show" readonly="1"/>
                            <field name="qty_available" optional="show" readonly="1"/>
                        </list>
                    </field>
                    <group>
                        <field name="notes" placeholder="Counselling notes, batch remarks…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pharmacy_dispense_list" model="ir.ui.view">
        <field name="name">pharmacy.dispense.list</field>
        <field name="model">pharmacy.dispense</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="dispense_date"/>
                <field name="prescription_id"/>
                <field name="patient_id"/>
                <field name="pharmacist_id"/>
                <field name="has_controlled" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_dispense_search" model="ir.ui.view">
        <field name="name">pharmacy.dispense.search</field>
        <field name="model">pharmacy.dispense</field>
        <field name="arch" type="xml">
            <search string="Dispensings">
                <field name="name"/>
                <field name="prescription_id"/>
                <field name="patient_id"/>
                <field name="pharmacist_id"/>
                <filter name="filter_done" string="Dispensed"
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_controlled" string="Controlled"
                        domain="[('has_controlled', '=', True)]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('dispense_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <group name="group_by" colspan="16">
                    <filter name="group_pharmacist" string="Pharmacist"
                            context="{'group_by': 'pharmacist_id'}"/>
                    <filter name="group_patient" string="Patient"
                            context="{'group_by': 'patient_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'dispense_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_dispense" model="ir.actions.act_window">
        <field name="name">Dispensings</field>
        <field name="res_model">pharmacy.dispense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pharmacy_dispense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No dispensing recorded yet</p>
            <p>Dispensings are normally started from a verified prescription, which
               pre-fills everything still outstanding.</p>
        </field>
    </record>

</odoo>
