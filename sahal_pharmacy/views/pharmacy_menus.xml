<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Every leaf below carries its own action. A menu that has children renders as a
         non-clickable section header in Odoo 19, so section items are deliberately
         action-free and the real screens sit one level down. -->

    <menuitem id="menu_pharmacy_root"
              name="Pharmacy"
              web_icon="sahal_pharmacy,static/description/icon.png"
              groups="sahal_pharmacy.group_pharmacy_cashier"
              sequence="45"/>

    <!-- Dispensing -->
    <menuitem id="menu_pharmacy_dispensing"
              name="Dispensing"
              parent="menu_pharmacy_root"
              sequence="10"/>

    <menuitem id="menu_pharmacy_prescriptions"
              name="Prescriptions"
              action="action_pharmacy_prescription"
              parent="menu_pharmacy_dispensing"
              sequence="10"/>

    <menuitem id="menu_pharmacy_to_verify"
              name="To Verify"
              action="action_pharmacy_prescription_to_verify"
              parent="menu_pharmacy_dispensing"
              groups="sahal_pharmacy.group_pharmacy_pharmacist"
              sequence="20"/>

    <menuitem id="menu_pharmacy_dispensings"
              name="Dispensings"
              action="action_pharmacy_dispense"
              parent="menu_pharmacy_dispensing"
              sequence="30"/>

