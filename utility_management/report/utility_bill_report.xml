<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A utility bill is not a generic sales invoice. The customer's first question is
         "what did the meter say and what did that cost", so the readings table comes
         before the charges, and the estimate flag is impossible to miss (SRS 14, 15). -->
    <template id="report_utility_bill_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page">
                <div class="row mb-3">
                    <div class="col-7">
                        <h3 class="mb-0">Utility Bill</h3>
                        <div t-field="doc.name"/>
                    </div>
                    <div class="col-5 text-end">
                        <div t-if="doc.utility_account_id">
                            <strong>Account:</strong>
                            <span t-field="doc.utility_account_id.name"/>
                        </div>
                        <div t-if="doc.utility_period_start">
                            <strong>Service period:</strong>
                            <span t-field="doc.utility_period_start"/> —
                            <span t-field="doc.utility_period_end"/>
                        </div>
                        <div>
                            <strong>Invoice date:</strong> <span t-field="doc.invoice_date"/>
                        </div>
                        <div t-if="doc.invoice_date_due">
                            <strong>Due date:</strong> <span t-field="doc.invoice_date_due"/>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Billed to</strong>
                        <div t-field="doc.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": true}'/>
                    </div>
                    <div class="col-6" t-if="doc.utility_account_id">
                        <strong>Service address</strong>
                        <div>
                            <span t-field="doc.utility_account_id.street"/><br/>
                            <span t-field="doc.utility_account_id.city"/>
                            <span t-field="doc.utility_account_id.area"/>
                        </div>
                    </div>
                </div>

                <div t-if="doc.utility_is_estimated" class="alert alert-warning">
                    <strong>This bill is based on an estimated reading.</strong>
                    It will be corrected against your next actual reading.
                </div>

                <h4 t-if="doc.utility_reading_ids">Meter readings</h4>
                <table class="table table-sm" t-if="doc.utility_reading_ids">
                    <thead>
                        <tr>
                            <th>Meter</th>
                            <th>Read on</th>
                            <th>Type</th>
                            <th class="text-end">Previous</th>
                            <th class="text-end">Present</th>
                            <th class="text-end">Consumption</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.utility_reading_ids" t-as="reading">
                            <td><span t-field="reading.meter_id.name"/></td>
                            <td><span t-field="reading.reading_date"/></td>
                            <td>
                                <span t-field="reading.reading_type"/>
                                <span t-if="reading.is_rollover" class="badge text-bg-info">rollover</span>
                            </td>
                            <td class="text-end"><span t-field="reading.previous_reading"/></td>
                            <td class="text-end"><span t-field="reading.present_reading"/></td>
                            <td class="text-end">
                                <span t-field="reading.consumption"/>
                                <span t-field="reading.meter_id.effective_tariff_id.unit_name"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h4>Charges</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit price</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"
                            t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.quantity"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-end"><span t-field="line.price_subtotal"
                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr>
                                <td>Subtotal</td>
                                <td class="text-end"><span t-field="doc.amount_untaxed"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr>
                                <td>Taxes</td>
                                <td class="text-end"><span t-field="doc.amount_tax"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr class="border-black o_total">
                                <td><strong>Total due</strong></td>
                                <td class="text-end"><strong><span t-field="doc.amount_total"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong></td>
                            </tr>
                            <tr t-if="doc.utility_account_id">
                                <td>Account balance after this bill</td>
                                <td class="text-end"><span t-field="doc.utility_account_id.balance"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="row mt-3" t-if="doc.name">
                    <div class="col-4">
                        <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=180&amp;height=180' % doc.name"
                             alt="Bill reference QR code" style="width:110px;height:110px;"/>
                        <div class="text-muted small">Quote <span t-field="doc.name"/> when paying.</div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_utility_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="utility_management.report_utility_bill_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_utility_bill" model="ir.actions.report">
        <field name="name">Utility Bill</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utility_management.report_utility_bill</field>
        <field name="report_file">utility_management.report_utility_bill</field>
        <field name="print_report_name">'Utility Bill - %s' % object.name</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
