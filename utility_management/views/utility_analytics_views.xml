<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SRS 24: consumption and billing analysis. Graph and pivot on the two models that
         hold the numbers - readings for consumption, run lines for what was billed. -->

    <record id="view_utility_reading_graph" model="ir.ui.view">
        <field name="name">utility.meter.reading.graph</field>
        <field name="model">utility.meter.reading</field>
        <field name="arch" type="xml">
            <graph string="Consumption" sample="1">
                <field name="reading_date" interval="month"/>
                <field name="utility_type"/>
                <field name="consumption" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_utility_reading_pivot" model="ir.ui.view">
        <field name="name">utility.meter.reading.pivot</field>
        <field name="model">utility.meter.reading</field>
        <field name="arch" type="xml">
            <pivot string="Consumption" sample="1">
                <field name="reading_date" interval="month" type="col"/>
                <field name="account_id" type="row"/>
                <field name="consumption" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_utility_run_line_graph" model="ir.ui.view">
        <field name="name">utility.billing.run.line.graph</field>
        <field name="model">utility.billing.run.line</field>
        <field name="arch" type="xml">
            <graph string="Billed" sample="1">
                <field name="account_id"/>
                <field name="amount" type="measure"/>
                <field name="consumption" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_utility_run_line_pivot" model="ir.ui.view">
        <field name="name">utility.billing.run.line.pivot</field>
        <field name="model">utility.billing.run.line</field>
        <field name="arch" type="xml">
            <pivot string="Billed" sample="1">
                <field name="run_id" type="col"/>
                <field name="account_id" type="row"/>
                <field name="amount" type="measure"/>
                <field name="consumption" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_utility_run_line_search" model="ir.ui.view">
        <field name="name">utility.billing.run.line.search</field>
        <field name="model">utility.billing.run.line</field>
        <field name="arch" type="xml">
            <search string="Billing Lines">
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="partner_id"/>
                <filter name="f_estimated" string="Estimated" domain="[('is_estimated','=',True)]"/>
                <filter name="f_exception" string="Held for Review"
                        domain="[('exception_state','not in',('normal','estimated'))]"/>
                <filter name="f_unbilled" string="Not Invoiced" domain="[('invoice_id','=',False)]"/>
                <group name="group_by" colspan="16">
                    <filter name="g_run" string="Run" context="{'group_by':'run_id'}"/>
                    <filter name="g_account" string="Service Account" context="{'group_by':'account_id'}"/>
                    <filter name="g_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_consumption_analysis" model="ir.actions.act_window">
        <field name="name">Consumption Analysis</field>
        <field name="res_model">utility.meter.reading</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="domain">[('state','in',('validated','billed'))]</field>
        <field name="search_view_id" ref="view_utility_reading_search"/>
    </record>

    <record id="action_utility_billing_analysis" model="ir.actions.act_window">
        <field name="name">Billing Analysis</field>
        <field name="res_model">utility.billing.run.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_utility_run_line_search"/>
    </record>

    <record id="action_utility_exceptions" model="ir.actions.act_window">
        <field name="name">Reading Exceptions</field>
        <field name="res_model">utility.meter.reading</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('exception_state','in',('review','invalid','tampering'))]</field>
        <field name="search_view_id" ref="view_utility_reading_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No readings are waiting for review</p>
            <p>Readings the validation engine could not clear appear here until a Billing
               Specialist approves, corrects or rejects them.</p>
        </field>
    </record>

</odoo>
