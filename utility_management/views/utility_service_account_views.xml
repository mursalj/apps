<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_utility_service_account_list" model="ir.ui.view">
        <field name="name">utility.service.account.list</field>
        <field name="model">utility.service.account</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('closed', 'transferred')"
                  decoration-danger="state == 'disconnected'"
                  decoration-warning="state == 'suspended'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="utility_type"/>
                <field name="area" optional="show"/>
                <field name="tariff_id" optional="show"/>
                <field name="billing_cycle_id" optional="hide"/>
                <field name="meter_count" string="Meters" optional="show"/>
                <field name="last_billed_date" optional="hide"/>
                <field name="balance" sum="Outstanding" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'suspended'"
                       decoration-danger="state == 'disconnected'"/>
            </list>
        </field>
    </record>

    <record id="view_utility_service_account_form" model="ir.ui.view">
        <field name="name">utility.service.account.form</field>
        <field name="model">utility.service.account</field>
        <field name="arch" type="xml">
            <form string="Service Account">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="state != 'active'"/>
                    <button name="action_disconnect" type="object" string="Disconnect"
                            invisible="state not in ('active', 'suspended')"/>
                    <button name="action_close" type="object" string="Close Account"
                            invisible="state in ('closed', 'transferred')"/>
                    <button name="action_send_statement" type="object"
                            string="Send Notice" invisible="state == 'pending'"/>
                    <button name="action_reset_pending" type="object" string="Reset to Pending"
                            invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,active,suspended,disconnected,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_meters" type="object"
                                class="oe_stat_button" icon="fa-tachometer">
                            <field name="meter_count" widget="statinfo" string="Meters"/>
                        </button>
                        <button name="action_view_readings" type="object"
                                class="oe_stat_button" icon="fa-list-ol">
                            <field name="reading_count" widget="statinfo" string="Readings"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="utility_type"/>
                            <field name="tariff_id"
                                   domain="[('utility_type', '=', utility_type)]"/>
                            <field name="billing_cycle_id"/>
                            <field name="estimation_method"/>
                            <field name="minimum_consumption"
                                   invisible="estimation_method == 'none'"/>
                            <field name="last_billed_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="connection_date"/>
                            <field name="disconnection_date"
                                   invisible="not disconnection_date"/>
                            <field name="deposit_amount"/>
                            <field name="balance"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Service Location" name="location">
                            <group>
                                <group>
                                    <field name="street"/>
                                    <field name="city"/>
                                    <field name="area"/>
                                </group>
                                <group>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                </group>
                            </group>
                        </page>
                        <page string="Meters" name="meters">
                            <field name="meter_ids"
                                   context="{'default_utility_type': utility_type}">
                                <list>
                                    <field name="name"/>
                                    <field name="meter_type"/>
                                    <field name="multiplier"/>
                                    <field name="last_reading"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Meter History" name="history">
                            <field name="installation_ids" readonly="1">
                                <list>
                                    <field name="meter_id"/>
                                    <field name="date_installed"/>
                                    <field name="date_removed"/>
                                    <field name="initial_reading"/>
                                    <field name="final_reading"/>
                                    <field name="reason"/>
                                    <field name="technician_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Communication" name="communication">
                            <group>
                                <group>
                                    <field name="notify_email"/>
                                    <field name="notify_whatsapp"/>
                                    <field name="notification_phone"/>
                                </group>
                            </group>
                            <field name="notification_ids" readonly="1">
                                <list decoration-muted="state == 'skipped'"
                                      decoration-danger="state == 'failed'">
                                    <field name="create_date"/>
                                    <field name="template_key"/>
                                    <field name="channel"/>
                                    <field name="recipient"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'sent'"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="error"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes on this account"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_utility_service_account_search" model="ir.ui.view">
        <field name="name">utility.service.account.search</field>
        <field name="model">utility.service.account</field>
        <field name="arch" type="xml">
            <search string="Service Accounts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="area"/>
                <field name="city"/>
                <filter name="f_active" string="Active" domain="[('state','=','active')]"/>
                <filter name="f_pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="f_suspended" string="Suspended" domain="[('state','=','suspended')]"/>
                <filter name="f_disconnected" string="Disconnected" domain="[('state','=','disconnected')]"/>
                <separator/>
                <filter name="f_owing" string="With Balance" domain="[('balance','&gt;',0)]"/>
                <filter name="f_no_tariff" string="No Tariff" domain="[('tariff_id','=',False)]"/>
                <group name="group_by" colspan="16">
                    <filter name="g_type" string="Utility" context="{'group_by':'utility_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="g_area" string="Area" context="{'group_by':'area'}"/>
                    <filter name="g_tariff" string="Tariff" context="{'group_by':'tariff_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_service_account" model="ir.actions.act_window">
        <field name="name">Service Accounts</field>
        <field name="res_model">utility.service.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_service_account_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a service account</p>
            <p>A service account is one connection at one address for one utility. A
               customer with electricity and water has two, each with its own meters,
               tariff, billing cycle and balance.</p>
        </field>
    </record>

    <!-- Meter installation history -->
    <record id="view_utility_installation_list" model="ir.ui.view">
        <field name="name">utility.meter.installation.list</field>
        <field name="model">utility.meter.installation</field>
        <field name="arch" type="xml">
            <list decoration-muted="date_removed">
                <field name="meter_id"/>
                <field name="account_id"/>
                <field name="partner_id" optional="show"/>
                <field name="date_installed"/>
                <field name="date_removed"/>
                <field name="initial_reading"/>
                <field name="final_reading"/>
                <field name="reason"/>
                <field name="technician_id" optional="show"/>
                <field name="is_current" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_utility_installation_form" model="ir.ui.view">
        <field name="name">utility.meter.installation.form</field>
        <field name="model">utility.meter.installation</field>
        <field name="arch" type="xml">
            <form string="Meter Installation">
                <sheet>
                    <group>
                        <group>
                            <field name="meter_id"/>
                            <field name="account_id"/>
                            <field name="reason"/>
                            <field name="technician_id"/>
                        </group>
                        <group>
                            <field name="date_installed"/>
                            <field name="date_removed"/>
                            <field name="initial_reading"/>
                            <field name="final_reading"/>
                        </group>
                    </group>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <field name="note" placeholder="What happened, and why"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_utility_installation" model="ir.actions.act_window">
        <field name="name">Meter History</field>
        <field name="res_model">utility.meter.installation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Billing cycles -->
    <record id="view_utility_billing_cycle_list" model="ir.ui.view">
        <field name="name">utility.billing.cycle.list</field>
        <field name="model">utility.billing.cycle</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="frequency"/>
                <field name="anchor_day"/>
                <field name="due_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_utility_billing_cycle" model="ir.actions.act_window">
        <field name="name">Billing Cycles</field>
        <field name="res_model">utility.billing.cycle</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
