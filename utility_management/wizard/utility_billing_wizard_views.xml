<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_utility_billing_wizard" model="ir.ui.view">
        <field name="name">utility.billing.wizard.form</field>
        <field name="model">utility.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Utility Invoices">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="utility_type"/>
                        <field name="reading_count" readonly="1"/>
                    </group>
                </group>
                <field name="partner_ids" widget="many2many_tags"
                       placeholder="All customers…"/>
                <footer>
                    <button name="action_generate" type="object" string="Generate Draft Invoices"
                            class="btn-primary" invisible="reading_count == 0"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_utility_billing_wizard" model="ir.actions.act_window">
        <field name="name">Generate Invoices</field>
        <field name="res_model">utility.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
